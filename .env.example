# Copy this file to .env and replace the values below.
# Never commit your .env file.
WEATHERLINK_API_KEY=your_api_key
WEATHERLINK_API_SECRET=your_api_secret

# Optional. Leave blank to use the first station returned by your account.
WEATHERLINK_STATION_ID=

# Optional application settings.
WEATHERLINK_REFRESH_SECONDS=60
WEATHERLINK_HISTORY_HOURS=24
WEATHERLINK_UNITS=metric
